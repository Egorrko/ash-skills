      "form"
    ]
  },
  "$defs": {
    "Form<{ text: string; }>": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "values": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        },
        "errors": {
          "$ref": "FormErrors<{ text: string; }>"
        },
        "valid": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "values",
        "errors",
        "valid"
      ]
    },
    "FormErrors<{ text: string; }>": {
      "type": "object",
      "properties": {
        "text": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      },
      "required": []
    }
  },
