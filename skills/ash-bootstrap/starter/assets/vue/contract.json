          "type": "object",
          "properties": {
            "id": {
              "type": "number"
            },
            "text": {
              "type": "string"
            },
            "completed": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "text",
            "completed"
          ]
        }
      },
      "form": {
        "$ref": "Form<{ text: string; }>"
      }
    },
    "required": [
