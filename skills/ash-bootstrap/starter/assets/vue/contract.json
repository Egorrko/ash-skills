            "id"
          ]
        },
        "reply": null,
        "components": [
          "VueDemo"
        ],
        "declared": [
          "assets/vue/VueDemo.vue"
        ]
      }
    ],
    "toggle_todo": [
      {
        "payload": {
          "type": "object",
          "properties": {
            "id": {
              "type": "number"
            }
          },
          "required": [
            "id"
          ]
        },
        "reply": null,
        "components": [
          "VueDemo"
        ],
        "declared": [
          "assets/vue/VueDemo.vue"
        ]
      }
    ]
  }
